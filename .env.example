# Translation API proxy (server/index.ts) — forwards requests to DeepL using the key from the UI
PORT=3001
# DEEPL_API_URL=https://api-free.deepl.com
# DEEPL_SOURCE_LANG=KO
# DEEPL_TARGET_LANG=EN-US

# Optional frontend override (defaults to same origin / Vite proxy in dev)
# VITE_API_BASE=http://localhost:3001
