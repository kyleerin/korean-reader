# API server (server/index.ts)
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Google sign-in (OAuth 2.0 web client)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SESSION_SECRET=replace-with-a-long-random-string

# DeepL translation (optional)
# Free API keys end with :fx (uses api-free.deepl.com automatically)
DEEPL_API_KEY=your-deepl-key:fx
# DEEPL_API_URL=https://api-free.deepl.com
# DEEPL_SOURCE_LANG=KO
# DEEPL_TARGET_LANG=EN-US

# Optional frontend API override (defaults to same origin / Vite proxy in dev)
# VITE_API_BASE=http://localhost:3001
